<Window x:Class="VelocimetroInternet.Apresentacao.PainelRapido"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Status Monitor — painel rápido"
        Width="360" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{DynamicResource Tema.Fonte}"
        FontSize="13"
        Foreground="{DynamicResource Tema.Texto}"
        TextOptions.TextFormattingMode="Display"
        AutomationProperties.Name="Status Monitor — painel rápido">

    <!--
        Painel rápido — "NetTraffic Quick Flyout" do Modelo 3 (design/modelo-3-acrylic-pill).
        Abre acima do widget (como o Clima abre os Widgets) ou acima da bandeja.
        Cores de Envio/Download vêm da paleta ativa, resolvidas para o tema dos APPS.
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="Painel.Upload" Color="#4CC2FF" />
        <SolidColorBrush x:Key="Painel.Download" Color="#FF6B6B" />
        <SolidColorBrush x:Key="Painel.UploadVeu" Color="#1A4CC2FF" />
        <SolidColorBrush x:Key="Painel.DownloadVeu" Color="#1AFF6B6B" />
        <SolidColorBrush x:Key="Painel.UploadBorda" Color="#404CC2FF" />
        <SolidColorBrush x:Key="Painel.DownloadBorda" Color="#40FF6B6B" />
        <SolidColorBrush x:Key="Painel.Trilho" Color="#24FFFFFF" />

        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Tema.TextoSecundario}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Border x:Name="Moldura"
            Background="{DynamicResource Tema.Superficie}"
            BorderBrush="{DynamicResource Tema.Borda}"
            BorderThickness="1" CornerRadius="8" Padding="16,14,16,16">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Deslize" Y="0" />
        </Border.RenderTransform>

        <StackPanel>
            <!-- Cabeçalho: título + "● Ao Vivo · Wi-Fi" + fechar -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEC4A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{DynamicResource Tema.Acento}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Status Monitor" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse x:Name="PontoAoVivo" Width="7" Height="7" Fill="{DynamicResource Tema.AoVivo}"
                                 VerticalAlignment="Center" Margin="1,0,6,0" />
                        <TextBlock x:Name="TextoStatus" Text="Ao vivo" FontSize="12"
                                   Foreground="{DynamicResource Tema.AoVivo}" VerticalAlignment="Center"
                                   AutomationProperties.Name="StatusPainel" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource BotaoDiscreto}" Padding="8" VerticalAlignment="Top"
                        Click="AoClicarFechar" ToolTip="Fechar (Esc)" AutomationProperties.Name="Fechar painel">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" />
                </Button>
            </Grid>

            <!-- Cartões Envio / Download -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource Painel.UploadVeu}" BorderBrush="{DynamicResource Painel.UploadBorda}"
                        BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <StackPanel>
                        <Grid>
                            <TextBlock FontSize="12" Foreground="{DynamicResource Painel.Upload}">
                                <Run Text="↑" FontWeight="Bold" /> <Run Text="Envio" />
                            </TextBlock>
                        </Grid>
                        <TextBlock Margin="0,4,0,8" Foreground="{DynamicResource Painel.Upload}">
                            <Run x:Name="NumeroUpload" Text="0,00" FontSize="26" FontWeight="SemiBold"
                                 Typography.NumeralAlignment="Tabular" />
                            <Run x:Name="UnidadeUpload" Text="KB/s" FontSize="12" Foreground="{DynamicResource Tema.TextoSecundario}" />
                        </TextBlock>
                        <Grid Height="4" x:Name="TrilhoUpload">
                            <Border Background="{DynamicResource Painel.Trilho}" CornerRadius="2" />
                            <Border x:Name="BarraUpload" Background="{DynamicResource Painel.Upload}" CornerRadius="2"
                                    HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <!-- Pico da janela de 60 s: linha própria (na mesma linha do rótulo, "Download" e o pico se sobrepunham) -->
                        <TextBlock x:Name="TextoPicoUpload" FontSize="11" Margin="0,6,0,0"
                                   Style="{StaticResource Rotulo}" Text="Pico: 0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource Painel.DownloadVeu}" BorderBrush="{DynamicResource Painel.DownloadBorda}"
                        BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <StackPanel>
                        <Grid>
                            <TextBlock FontSize="12" Foreground="{DynamicResource Painel.Download}">
                                <Run Text="↓" FontWeight="Bold" /> <Run Text="Download" />
                            </TextBlock>
                        </Grid>
                        <TextBlock Margin="0,4,0,8" Foreground="{DynamicResource Painel.Download}">
                            <Run x:Name="NumeroDownload" Text="0,00" FontSize="26" FontWeight="SemiBold"
                                 Typography.NumeralAlignment="Tabular" />
                            <Run x:Name="UnidadeDownload" Text="KB/s" FontSize="12" Foreground="{DynamicResource Tema.TextoSecundario}" />
                        </TextBlock>
                        <Grid Height="4" x:Name="TrilhoDownload">
                            <Border Background="{DynamicResource Painel.Trilho}" CornerRadius="2" />
                            <Border x:Name="BarraDownload" Background="{DynamicResource Painel.Download}" CornerRadius="2"
                                    HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <!-- Pico da janela de 60 s: linha própria (na mesma linha do rótulo, "Download" e o pico se sobrepunham) -->
                        <TextBlock x:Name="TextoPicoDownload" FontSize="11" Margin="0,6,0,0"
                                   Style="{StaticResource Rotulo}" Text="Pico: 0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Telemetria dos últimos 60 s -->
            <Border Background="{DynamicResource Tema.SuperficieRecuada}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                <StackPanel>
                    <!-- v1.1.0: seletor da janela do gráfico (1 min = um ponto por medição;
                         5 min = um ponto a cada 5 s; 1 h = um ponto por minuto) -->
                    <Grid Margin="0,0,0,8">
                        <Border HorizontalAlignment="Left" Background="{DynamicResource Tema.Superficie}"
                                CornerRadius="6" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="OpcaoJanela1Min" GroupName="JanelaGrafico" Style="{StaticResource Segmento}"
                                             Content="1 min" Checked="AoEscolherJanela"
                                             AutomationProperties.Name="Gráfico do último minuto" />
                                <RadioButton x:Name="OpcaoJanela5Min" GroupName="JanelaGrafico" Style="{StaticResource Segmento}"
                                             Content="5 min" Checked="AoEscolherJanela"
                                             AutomationProperties.Name="Gráfico dos últimos 5 minutos" />
                                <RadioButton x:Name="OpcaoJanela1h" GroupName="JanelaGrafico" Style="{StaticResource Segmento}"
                                             Content="1 h" Checked="AoEscolherJanela"
                                             AutomationProperties.Name="Gráfico da última hora" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="TextoLink" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource Tema.Acento}" Text="" />
                    </Grid>
                    <!--
                        v0.3.0: linhas-guia de referência. O topo do gráfico é um valor REDONDO
                        (1-2-5: 1 MB/s, 20 Mbps…) e a linha do meio é a metade — dá noção de grandeza
                        de relance. Ficam ATRÁS das curvas e com rótulo pequeno à esquerda.
                    -->
                    <Canvas x:Name="Grafico" Height="84" ClipToBounds="True" SizeChanged="AoMudarTamanhoGrafico">
                        <Line x:Name="GuiaTopo" Stroke="{DynamicResource Tema.TextoSecundario}" StrokeThickness="1"
                              StrokeDashArray="3 3" Opacity="0.55" Visibility="Collapsed" />
                        <Line x:Name="GuiaMeio" Stroke="{DynamicResource Tema.TextoSecundario}" StrokeThickness="1"
                              StrokeDashArray="1 4" Opacity="0.4" Visibility="Collapsed" />
                        <TextBlock x:Name="RotuloTopo" FontSize="10" Foreground="{DynamicResource Tema.TextoSecundario}"
                                   Visibility="Collapsed" AutomationProperties.Name="EscalaTopoGrafico" />
                        <TextBlock x:Name="RotuloMeio" FontSize="10" Foreground="{DynamicResource Tema.TextoSecundario}"
                                   Opacity="0.85" Visibility="Collapsed" />
                        <Path x:Name="AreaDownload" Fill="{DynamicResource Painel.DownloadVeu}" />
                        <Path x:Name="LinhaDownload" Stroke="{DynamicResource Painel.Download}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" />
                        <Path x:Name="AreaUpload" Fill="{DynamicResource Painel.UploadVeu}" />
                        <Path x:Name="LinhaUpload" Stroke="{DynamicResource Painel.Upload}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" />
                    </Canvas>
                    <!-- Legenda das cores + estado (aguardando amostras) -->
                    <Grid Margin="0,6,0,0">
                        <TextBlock FontSize="10" Foreground="{DynamicResource Tema.TextoSecundario}">
                            <Run Text="━" Foreground="{DynamicResource Painel.Upload}" /> <Run Text="Envio" />
                            <Run Text="   " />
                            <Run Text="━" Foreground="{DynamicResource Painel.Download}" /> <Run Text="Download" />
                        </TextBlock>
                        <!-- Média da janela escolhida (ou "aguardando…" enquanto não há 2 pontos) -->
                        <TextBlock x:Name="TextoEscala" FontSize="10" HorizontalAlignment="Right" Style="{StaticResource Rotulo}"
                                   Typography.NumeralAlignment="Tabular" AutomationProperties.Name="MediaGrafico"
                                   Text="Aguardando amostras…" />
                    </Grid>
                    <!-- v1.1.0: latência (só com "Medir latência" ligado no estúdio) -->
                    <Grid x:Name="BlocoLatencia" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock Text="Latência" FontSize="11" Style="{StaticResource Rotulo}" />
                        <TextBlock x:Name="TextoLatencia" HorizontalAlignment="Right" FontSize="11"
                                   Typography.NumeralAlignment="Tabular" AutomationProperties.Name="Latencia" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Consumo do dia e (v1.0.0) do mês, com a franquia quando definida -->
            <Border BorderBrush="{DynamicResource Tema.Borda}" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource Tema.TextoSecundario}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Consumo de hoje" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                                   Typography.NumeralAlignment="Tabular" AutomationProperties.Name="ConsumoHoje">
                            <Run x:Name="ConsumoUpload" Text="↑ 0 B" Foreground="{DynamicResource Painel.Upload}" />
                            <Run Text=" · " Foreground="{DynamicResource Tema.TextoSecundario}" />
                            <Run x:Name="ConsumoDownload" Text="↓ 0 B" Foreground="{DynamicResource Painel.Download}" />
                        </TextBlock>
                    </Grid>
                    <Grid Margin="0,7,0,0">
                        <!-- Mesmo recuo do texto de cima (ícone 13 + margem 8), para as linhas alinharem -->
                        <TextBlock Text="Este mês" Margin="21,0,0,0" VerticalAlignment="Center" FontSize="12" />
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                                   Typography.NumeralAlignment="Tabular" AutomationProperties.Name="ConsumoMes">
                            <Run x:Name="ConsumoMesUpload" Text="↑ 0 B" Foreground="{DynamicResource Painel.Upload}" />
                            <Run Text=" · " Foreground="{DynamicResource Tema.TextoSecundario}" />
                            <Run x:Name="ConsumoMesDownload" Text="↓ 0 B" Foreground="{DynamicResource Painel.Download}" />
                        </TextBlock>
                    </Grid>
                    <!-- Franquia (só aparece com franquia definida no estúdio) -->
                    <StackPanel x:Name="BlocoFranquia" Margin="21,8,0,0" Visibility="Collapsed">
                        <!-- Colunas proporcionais (usado* / resto*): a barra fica certa já na 1ª
                             abertura, sem depender da largura medida do trilho (que é 0 enquanto
                             o bloco estava recolhido) -->
                        <Grid Height="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ColunaFranquiaUsada" Width="0*" />
                                <ColumnDefinition x:Name="ColunaFranquiaResto" Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" Background="{DynamicResource Painel.Trilho}" CornerRadius="2" />
                            <Border x:Name="BarraFranquia" Background="{DynamicResource Tema.Acento}" CornerRadius="2" />
                        </Grid>
                        <TextBlock x:Name="TextoFranquia" Margin="0,5,0,0" FontSize="11" Style="{StaticResource Rotulo}"
                                   AutomationProperties.Name="Franquia" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Height="1" Background="{DynamicResource Tema.Borda}" Margin="0,0,0,10" />

            <!-- Configurações rápidas -->
            <Grid Margin="0,0,0,10">
                <TextBlock Text="Unidade de exibição" VerticalAlignment="Center" />
                <Border HorizontalAlignment="Right" Background="{DynamicResource Tema.SuperficieRecuada}"
                        CornerRadius="6" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="OpcaoMbps" GroupName="Unidade" Style="{StaticResource Segmento}" Content="Mbps"
                                     Checked="AoEscolherUnidade" AutomationProperties.Name="Unidade Mbps" />
                        <RadioButton x:Name="OpcaoMBs" GroupName="Unidade" Style="{StaticResource Segmento}" Content="MB/s"
                                     Checked="AoEscolherUnidade" AutomationProperties.Name="Unidade MB/s" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,10">
                <TextBlock Text="Iniciar com o Windows" VerticalAlignment="Center" />
                <ToggleButton x:Name="ChaveIniciar" HorizontalAlignment="Right" Style="{StaticResource Interruptor}"
                              Click="AoAlternarIniciar" AutomationProperties.Name="Iniciar com o Windows" />
            </Grid>

            <Grid Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Fixar na barra" VerticalAlignment="Center" />
                    <TextBlock Text="Desligado, fica só o ícone perto do relógio." Style="{StaticResource Rotulo}" FontSize="11" />
                </StackPanel>
                <ToggleButton x:Name="ChaveFixar" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Style="{StaticResource Interruptor}"
                              Click="AoAlternarFixar" AutomationProperties.Name="Fixar na barra" />
            </Grid>

            <!-- v0.5.0: liga/desliga a coluna CPU/RAM (%) à esquerda do upload/download no widget -->
            <Grid Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="CPU e RAM na barra" VerticalAlignment="Center" />
                    <TextBlock Text="Uso do computador em %, à esquerda da internet." Style="{StaticResource Rotulo}" FontSize="11" />
                </StackPanel>
                <ToggleButton x:Name="ChaveSistema" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Style="{StaticResource Interruptor}"
                              Click="AoAlternarSistema" AutomationProperties.Name="CPU e RAM na barra" />
            </Grid>

            <!-- Rodapé: estúdio à esquerda e (v1.2.0) teste de velocidade à direita -->
            <Grid>
                <Button Style="{StaticResource BotaoDiscreto}" Padding="8,6" HorizontalAlignment="Left"
                        Click="AoClicarEstudio" AutomationProperties.Name="Abrir estúdio de cores">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Tema.Acento}" />
                        <TextBlock Text="Cores e mais configurações" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Tema.Acento}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BotaoDiscreto}" Padding="8,6" HorizontalAlignment="Right"
                        Click="AoClicarTeste" AutomationProperties.Name="Testar velocidade">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEC4A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Tema.Acento}" />
                        <TextBlock Text="Testar velocidade" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Tema.Acento}" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
