<Window x:Class="VelocimetroInternet.Apresentacao.TaskbarWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="VelocimetroInternetWidget"
        Width="150" Height="42"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        AutomationProperties.Name="Status Monitor">

    <Window.Resources>
        <!-- Paleta Escura Padrão — Modelo 3: Minimalismo Acrylic Pill (WCAG AAA/AA+) -->
        <SolidColorBrush x:Key="UploadTextBrush" Color="#FF4CC2FF" />
        <SolidColorBrush x:Key="DownloadTextBrush" Color="#FFFF6B6B" />
        <SolidColorBrush x:Key="UploadPillBgBrush" Color="#2E4CC2FF" />
        <SolidColorBrush x:Key="UploadPillBorderBrush" Color="#484CC2FF" />
        <SolidColorBrush x:Key="DownloadPillBgBrush" Color="#2EFF6B6B" />
        <SolidColorBrush x:Key="DownloadPillBorderBrush" Color="#48FF6B6B" />
        <SolidColorBrush x:Key="HoverContainerBrush" Color="#12FFFFFF" />
        <!-- v0.2.0: modo compacto também segue o tema/paleta (antes era fixo no escuro) -->
        <SolidColorBrush x:Key="CompactoFundoBrush" Color="#261E2026" />
        <SolidColorBrush x:Key="CompactoBordaBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="SeparadorBrush" Color="#55FFFFFF" />
        <!-- v0.5.0: CPU/RAM em tom NEUTRO (branco na barra escura, preto na clara), para não
             competir com as cores de upload/download. Ajustados por AplicarCores. -->
        <SolidColorBrush x:Key="SistemaTextBrush" Color="#E6FFFFFF" />
        <SolidColorBrush x:Key="SistemaRotuloBrush" Color="#A6FFFFFF" />
        <SolidColorBrush x:Key="SistemaPillBgBrush" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="SistemaPillBorderBrush" Color="#33FFFFFF" />

        <!-- v0.8.0: fonte e tamanhos do texto viram recursos, trocados por AplicarAparencia
             (estúdio → "Fonte" e "Tamanho do texto"). Os valores abaixo são os de sempre. -->
        <FontFamily x:Key="Widget.Fonte">Segoe UI Variable Text, Segoe UI</FontFamily>
        <sys:Double x:Key="Widget.TamanhoValor">10.5</sys:Double>
        <sys:Double x:Key="Widget.TamanhoRotulo">9</sys:Double>
        <sys:Double x:Key="Widget.TamanhoCompacto">10</sys:Double>
        <sys:Double x:Key="Widget.TamanhoSeparador">9.5</sys:Double>
    </Window.Resources>

    <!-- Contêiner externo estilo botão Clima/Widgets do Windows 11 (hover suave arredondado de 4px) -->
    <Border x:Name="ContornoHover"
            CornerRadius="5"
            Padding="4,2"
            Background="Transparent"
            Cursor="Hand">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverContainerBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <!-- MODO NORMAL (2 Linhas com Micro-Pílulas Translúcidas — Modelo 3 Acrylic Pill) -->
            <Grid x:Name="PainelDuasLinhas" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="2" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- v0.5.0: coluna 0 = CPU/RAM (some quando desligado), 1 = respiro, 2 = rede -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColunaSistema" Width="61" />
                    <ColumnDefinition x:Name="ColunaRespiro" Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Linha 0 / coluna 0: CPU (pílula neutra). Largura fixa = cabe "CPU 100%" sem cortar. -->
                <Border x:Name="PilulaCpu" Grid.Row="0" Grid.Column="0"
                        CornerRadius="4"
                        Background="{DynamicResource SistemaPillBgBrush}"
                        BorderBrush="{DynamicResource SistemaPillBorderBrush}"
                        BorderThickness="0.75"
                        Padding="5,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CPU"
                                   Foreground="{DynamicResource SistemaRotuloBrush}"
                                   FontFamily="{DynamicResource Widget.Fonte}" FontSize="{DynamicResource Widget.TamanhoRotulo}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TextoCpu" Grid.Column="1" Text="12%"
                                   Foreground="{DynamicResource SistemaTextBrush}"
                                   FontFamily="{DynamicResource Widget.Fonte}" FontSize="{DynamicResource Widget.TamanhoValor}" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   AutomationProperties.Name="TextoCpuBarra" />
                    </Grid>
                </Border>

                <!-- Linha 2 / coluna 0: RAM, logo abaixo da CPU -->
                <Border x:Name="PilulaRam" Grid.Row="2" Grid.Column="0"
                        CornerRadius="4"
                        Background="{DynamicResource SistemaPillBgBrush}"
                        BorderBrush="{DynamicResource SistemaPillBorderBrush}"
                        BorderThickness="0.75"
                        Padding="5,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="RAM"
                                   Foreground="{DynamicResource SistemaRotuloBrush}"
                                   FontFamily="{DynamicResource Widget.Fonte}" FontSize="{DynamicResource Widget.TamanhoRotulo}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TextoRam" Grid.Column="1" Text="48%"
                                   Foreground="{DynamicResource SistemaTextBrush}"
                                   FontFamily="{DynamicResource Widget.Fonte}" FontSize="{DynamicResource Widget.TamanhoValor}" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   AutomationProperties.Name="TextoRamBarra" />
                    </Grid>
                </Border>

                <!-- Linha 0: Pílula de Upload (Azul #4CC2FF). v0.8.0: nomeada — "download em cima" troca as linhas -->
                <Border x:Name="PilulaUpload" Grid.Row="0" Grid.Column="2"
                        CornerRadius="4"
                        Background="{DynamicResource UploadPillBgBrush}"
                        BorderBrush="{DynamicResource UploadPillBorderBrush}"
                        BorderThickness="0.75"
                        Padding="6,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="↑"
                                   Foreground="{DynamicResource UploadTextBrush}"
                                   FontFamily="{DynamicResource Widget.Fonte}"
                                   FontSize="{DynamicResource Widget.TamanhoValor}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TextoUpload"
                                   Grid.Column="1"
                                   Text="1,24 MB/s"
                                   Foreground="{DynamicResource UploadTextBrush}"
                                   FontFamily="{DynamicResource Widget.Fonte}"
                                   FontSize="{DynamicResource Widget.TamanhoValor}"
                                   FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="TextoUploadBarra" />
                    </Grid>
                </Border>

                <!-- Linha 2: Pílula de Download (Vermelho #FF6B6B) -->
                <Border x:Name="PilulaDownload" Grid.Row="2" Grid.Column="2"
                        CornerRadius="4"
                        Background="{DynamicResource DownloadPillBgBrush}"
                        BorderBrush="{DynamicResource DownloadPillBorderBrush}"
                        BorderThickness="0.75"
                        Padding="6,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="↓"
                                   Foreground="{DynamicResource DownloadTextBrush}"
                                   FontFamily="{DynamicResource Widget.Fonte}"
                                   FontSize="{DynamicResource Widget.TamanhoValor}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TextoDownload"
                                   Grid.Column="1"
                                   Text="38,7 MB/s"
                                   Foreground="{DynamicResource DownloadTextBrush}"
                                   FontFamily="{DynamicResource Widget.Fonte}"
                                   FontSize="{DynamicResource Widget.TamanhoValor}"
                                   FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="TextoDownloadBarra" />
                    </Grid>
                </Border>
            </Grid>

            <!-- MODO COMPACTO ANTI-COLISÃO (1 Linha quando a barra enche de aplicativos — Modelo 3 Etapa 2) -->
            <Border x:Name="PainelCompactoUmaLinha"
                    Visibility="Collapsed"
                    CornerRadius="4"
                    Background="{DynamicResource CompactoFundoBrush}"
                    BorderBrush="{DynamicResource CompactoBordaBrush}"
                    BorderThickness="0.75"
                    Padding="6,3"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <!-- v0.8.0: nomeada — "download em cima" reordena os filhos (↓ antes do ↑) -->
                <StackPanel x:Name="LinhaCompacta" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- v0.5.0: "CPU 12% · RAM 48%  |" antes do ↑↓ (some quando desligado) -->
                    <StackPanel x:Name="CompactoSistema" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TextoCompactoSistema"
                                   Text="CPU 12% · RAM 48%"
                                   Foreground="{DynamicResource SistemaTextBrush}"
                                   FontFamily="{DynamicResource Widget.Fonte}"
                                   FontSize="{DynamicResource Widget.TamanhoCompacto}"
                                   FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="TextoCompactoSistemaBarra" />
                        <TextBlock Text="  |  "
                                   Foreground="{DynamicResource SeparadorBrush}"
                                   FontFamily="{DynamicResource Widget.Fonte}"
                                   FontSize="{DynamicResource Widget.TamanhoSeparador}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="TextoCompactoUpload"
                               Text="↑ 1,2"
                               Foreground="{DynamicResource UploadTextBrush}"
                               FontFamily="{DynamicResource Widget.Fonte}"
                               FontSize="{DynamicResource Widget.TamanhoCompacto}"
                               FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="TextoCompactoUploadBarra" />
                    <TextBlock x:Name="SeparadorCompactoRede" Text="  |  "
                               Foreground="{DynamicResource SeparadorBrush}"
                               FontFamily="{DynamicResource Widget.Fonte}"
                               FontSize="{DynamicResource Widget.TamanhoSeparador}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="TextoCompactoDownload"
                               Text="↓ 38,7 MB/s"
                               Foreground="{DynamicResource DownloadTextBrush}"
                               FontFamily="{DynamicResource Widget.Fonte}"
                               FontSize="{DynamicResource Widget.TamanhoCompacto}"
                               FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="TextoCompactoDownloadBarra" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
