<Window x:Class="VelocimetroInternet.Apresentacao.EstudioCores"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:apr="clr-namespace:VelocimetroInternet.Apresentacao"
        Title="Status Monitor — cores e configurações"
        Width="780" Height="720" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Tema.Superficie}"
        Foreground="{DynamicResource Tema.Texto}"
        FontFamily="{DynamicResource Tema.Fonte}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        AutomationProperties.Name="Status Monitor — cores e configurações">

    <!--
        Estúdio de Cores & Configurações — Onda 3, a partir do Modelo 3 (design/modelo-3-acrylic-pill):
        simulador nas barras escura (#1C1C1C) e clara (#F3F3F3) com selo de contraste WCAG,
        galeria das 5 paletas + personalizada, e as demais preferências.
        Edita uma CÓPIA da configuração: nada muda na barra até "Aplicar".
    -->
    <Window.Resources>
        <Style x:Key="Titulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Tema.TextoSecundario}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Tema.SuperficieElevada}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Tema.Borda}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Tema.SuperficieRecuada}" />
            <Setter Property="Foreground" Value="{DynamicResource Tema.Texto}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Tema.Texto}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Tema.Borda}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Caixa" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Caixa" Property="BorderBrush" Value="{DynamicResource Tema.Acento}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cartão selecionável da galeria de paletas -->
        <Style x:Key="CartaoPaleta" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Tema.Texto}" />
            <Setter Property="Width" Value="216" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Caixa" Background="{DynamicResource Tema.SuperficieRecuada}"
                                BorderBrush="{DynamicResource Tema.Borda}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Caixa" Property="BorderBrush" Value="{DynamicResource Tema.Acento}" />
                                <Setter TargetName="Caixa" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Caixa" Property="Background" Value="{DynamicResource Tema.Realce}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Caixa" Property="BorderBrush" Value="{DynamicResource Tema.Texto}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,4">
            <StackPanel>
                <!-- 1. Simulador nas duas barras -->
                <TextBlock Text="Como fica na barra" Style="{StaticResource Titulo}" />
                <TextBlock Style="{StaticResource Rotulo}" Margin="0,0,0,12"
                           Text="O Windows pode usar barra escura ou clara. As cores são recalibradas automaticamente para manter o texto legível (contraste mínimo 4,5:1)." />

                <UniformGrid Columns="2" Margin="0,0,0,20">
                    <StackPanel Margin="0,0,8,0">
                        <Border Background="#1C1C1C" CornerRadius="6" Height="64" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <ContentControl x:Name="AmostraEscura" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Barra escura" Style="{StaticResource Rotulo}" VerticalAlignment="Center" />
                            <Border x:Name="SeloEscuro" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" BorderThickness="1">
                                <TextBlock x:Name="TextoSeloEscuro" FontSize="11" AutomationProperties.Name="ContrasteBarraEscura" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="8,0,0,0">
                        <Border Background="#F3F3F3" CornerRadius="6" Height="64" BorderBrush="#26000000" BorderThickness="1">
                            <ContentControl x:Name="AmostraClara" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Barra clara" Style="{StaticResource Rotulo}" VerticalAlignment="Center" />
                            <Border x:Name="SeloClaro" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" BorderThickness="1">
                                <TextBlock x:Name="TextoSeloClaro" FontSize="11" AutomationProperties.Name="ContrasteBarraClara" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </UniformGrid>

                <!-- 2. Galeria -->
                <TextBlock Text="Paleta" Style="{StaticResource Titulo}" />
                <TextBlock Style="{StaticResource Rotulo}" Margin="0,0,0,12" Text="Seta para cima = envio (upload). Seta para baixo = download." />
                <WrapPanel x:Name="Galeria" Margin="0,0,0,6" />

                <!-- Personalizada -->
                <Border x:Name="PainelPersonalizada" Style="{StaticResource Cartao}">
                    <StackPanel>
                        <TextBlock Text="Cores personalizadas" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="↑ Envio" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="CampoCorUpload" Grid.Column="1" MaxLength="7" TextChanged="AoMudarCorPersonalizada"
                                     AutomationProperties.Name="Cor de envio (hexadecimal)" />
                            <TextBlock Grid.Column="3" Text="↓ Download" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="CampoCorDownload" Grid.Column="4" MaxLength="7" TextChanged="AoMudarCorPersonalizada"
                                     AutomationProperties.Name="Cor de download (hexadecimal)" />
                        </Grid>
                        <TextBlock x:Name="AvisoCor" Style="{StaticResource Rotulo}" Margin="0,8,0,0"
                                   Text="Formato #RRGGBB, ex.: #4CC2FF. Pense na barra escura; a versão clara é ajustada sozinha." />

                        <!-- v0.9.0 (Onda 3): seletor visual. Edita a cor escolhida no segmento e escreve
                             o hex no campo correspondente (o campo continua sendo a fonte da verdade). -->
                        <Grid Margin="0,16,0,8">
                            <TextBlock Text="Ajustar no seletor" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" Background="{DynamicResource Tema.SuperficieRecuada}" CornerRadius="6" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="AlvoUpload" GroupName="AlvoCor" Tag="envio" Style="{StaticResource Segmento}"
                                                 IsChecked="True" Checked="AoEscolherAlvoCor" AutomationProperties.Name="Ajustar a cor de envio">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="AmostraAlvoUpload" Width="12" Height="12" CornerRadius="3" Margin="0,0,6,0"
                                                    BorderBrush="{DynamicResource Tema.Borda}" BorderThickness="1" VerticalAlignment="Center" />
                                            <TextBlock Text="↑ Envio" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="AlvoDownload" GroupName="AlvoCor" Tag="download" Style="{StaticResource Segmento}"
                                                 Checked="AoEscolherAlvoCor" AutomationProperties.Name="Ajustar a cor de download">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="AmostraAlvoDownload" Width="12" Height="12" CornerRadius="3" Margin="0,0,6,0"
                                                    BorderBrush="{DynamicResource Tema.Borda}" BorderThickness="1" VerticalAlignment="Center" />
                                            <TextBlock Text="↓ Download" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <apr:SeletorCor x:Name="Seletor" />
                    </StackPanel>
                </Border>

                <!-- 3. v0.8.0: aparência e lugar na barra (itens adiados da Onda 2) -->
                <TextBlock Text="Na barra de tarefas" Style="{StaticResource Titulo}" />
                <Border Style="{StaticResource Cartao}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Tamanho do texto" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" Background="{DynamicResource Tema.SuperficieRecuada}" CornerRadius="6" Padding="2">
                                <StackPanel x:Name="GrupoTamanho" Orientation="Horizontal">
                                    <RadioButton GroupName="Tamanho" Tag="pequeno" Content="Pequeno" Style="{StaticResource Segmento}"
                                                 Checked="AoEscolherOpcao" AutomationProperties.Name="Texto pequeno" />
                                    <RadioButton GroupName="Tamanho" Tag="normal" Content="Normal" Style="{StaticResource Segmento}"
                                                 Checked="AoEscolherOpcao" AutomationProperties.Name="Texto normal" />
                                    <RadioButton GroupName="Tamanho" Tag="grande" Content="Grande" Style="{StaticResource Segmento}"
                                                 Checked="AoEscolherOpcao" AutomationProperties.Name="Texto grande" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Fonte" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" Background="{DynamicResource Tema.SuperficieRecuada}" CornerRadius="6" Padding="2">
                                <!-- Cada opção escrita na própria fonte: dá para escolher vendo -->
                                <StackPanel x:Name="GrupoFonte" Orientation="Horizontal">
                                    <RadioButton GroupName="Fonte" Tag="segoe" Content="Segoe UI Variable" Style="{StaticResource Segmento}"
                                                 FontFamily="Segoe UI Variable Text" Checked="AoEscolherOpcao" AutomationProperties.Name="Fonte Segoe UI Variable" />
                                    <RadioButton GroupName="Fonte" Tag="segoe-classica" Content="Segoe UI" Style="{StaticResource Segmento}"
                                                 FontFamily="Segoe UI" Checked="AoEscolherOpcao" AutomationProperties.Name="Fonte Segoe UI" />
                                    <RadioButton GroupName="Fonte" Tag="cascadia" Content="Cascadia Mono" Style="{StaticResource Segmento}"
                                                 FontFamily="Cascadia Mono, Consolas" Checked="AoEscolherOpcao" AutomationProperties.Name="Fonte Cascadia Mono" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Linha de cima" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" Background="{DynamicResource Tema.SuperficieRecuada}" CornerRadius="6" Padding="2">
                                <StackPanel x:Name="GrupoOrdem" Orientation="Horizontal">
                                    <RadioButton GroupName="Ordem" Tag="envio" Content="↑ Envio" Style="{StaticResource Segmento}"
                                                 Checked="AoEscolherOpcao" AutomationProperties.Name="Envio em cima" />
                                    <RadioButton GroupName="Ordem" Tag="download" Content="↓ Download" Style="{StaticResource Segmento}"
                                                 Checked="AoEscolherOpcao" AutomationProperties.Name="Download em cima" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,4,0,12">
                            <StackPanel Margin="0,0,56,0">
                                <TextBlock Text="Mostrar em todos os monitores" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Rotulo}"
                                           Text="Põe o widget também na barra dos outros monitores. Requer a barra ligada neles (Configurações do Windows › Personalização › Barra de tarefas › Comportamentos)." />
                            </StackPanel>
                            <ToggleButton x:Name="ChaveMonitores" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Style="{StaticResource Interruptor}" Click="AoAlternarMonitores"
                                          AutomationProperties.Name="Mostrar em todos os monitores" />
                        </Grid>

                        <TextBlock Style="{StaticResource Rotulo}"
                                   Text="Mudar de lugar: segure Ctrl e arraste o widget pela barra. Para voltar ao lugar de sempre, clique com o botão direito nele › Voltar à posição automática." />
                    </StackPanel>
                </Border>

                <!-- 4. Medição e exibição -->
                <TextBlock Text="Medição" Style="{StaticResource Titulo}" />
                <Border Style="{StaticResource Cartao}">
                    <StackPanel>
                        <!-- v0.8.0: intervalo de atualização (item adiado da Onda 2) -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Atualizar a cada" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" Background="{DynamicResource Tema.SuperficieRecuada}" CornerRadius="6" Padding="2">
                                <StackPanel x:Name="GrupoIntervalo" Orientation="Horizontal">
                                    <RadioButton GroupName="Intervalo" Tag="0.5" Content="0,5 s" Style="{StaticResource Segmento}"
                                                 Checked="AoEscolherOpcao" AutomationProperties.Name="Atualizar a cada 0,5 segundo" />
                                    <RadioButton GroupName="Intervalo" Tag="1" Content="1 s" Style="{StaticResource Segmento}"
                                                 Checked="AoEscolherOpcao" AutomationProperties.Name="Atualizar a cada 1 segundo" />
                                    <RadioButton GroupName="Intervalo" Tag="2" Content="2 s" Style="{StaticResource Segmento}"
                                                 Checked="AoEscolherOpcao" AutomationProperties.Name="Atualizar a cada 2 segundos" />
                                    <RadioButton GroupName="Intervalo" Tag="5" Content="5 s" Style="{StaticResource Segmento}"
                                                 Checked="AoEscolherOpcao" AutomationProperties.Name="Atualizar a cada 5 segundos" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Style="{StaticResource Rotulo}" Margin="0,0,0,16"
                                   Text="Mais rápido = números mais vivos; mais lento = menos movimento na barra. O gráfico do painel continua mostrando os últimos 60 segundos." />

                        <TextBlock Text="Suavização" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Rotulo}" Text="Mais suave = números mais estáveis, reação mais lenta a picos." Margin="0,2,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Imediata" Style="{StaticResource Rotulo}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Slider x:Name="ControleSuavizacao" Grid.Column="1" Minimum="0" Maximum="0.9" TickFrequency="0.1"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="AoMudarSuavizacao"
                                    AutomationProperties.Name="Suavização" />
                            <TextBlock Grid.Column="2" Text="Suave" Style="{StaticResource Rotulo}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBlock x:Name="TextoSuavizacao" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Velocidade do seu plano" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock Style="{StaticResource Rotulo}" Margin="0,2,0,6"
                                   Text="Usada nas barras de progresso do painel rápido. Em branco ou 0 = usa a velocidade de link da placa de rede." />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="CampoPlano" Width="100" TextChanged="AoMudarPlano" AutomationProperties.Name="Velocidade do plano em Mbps" />
                            <TextBlock Text="Mbps" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="Ignorar interfaces de rede" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock Style="{StaticResource Rotulo}" Margin="0,2,0,6"
                                   Text="Um trecho de nome por linha (ex.: Ethernet 2). VPNs e adaptadores virtuais já são ignorados automaticamente." />
                        <TextBox x:Name="CampoExcluir" AcceptsReturn="True" Height="64" VerticalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" TextChanged="AoMudarExclusoes" AutomationProperties.Name="Interfaces ignoradas" />
                        <TextBlock x:Name="TextoInterfacesAtivas" Style="{StaticResource Rotulo}" Margin="0,6,0,0" />

                        <!-- v1.0.0 (Onda 5): cor por intensidade (opcional, desligada por padrão) -->
                        <Grid Margin="0,16,0,0">
                            <StackPanel Margin="0,0,56,0">
                                <TextBlock Text="Cor por intensidade" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Rotulo}"
                                           Text="Os números ficam mais fortes quanto mais perto da velocidade do plano (ou do link da placa, sem plano) — dá para ver de relance se a internet está cheia." />
                            </StackPanel>
                            <ToggleButton x:Name="ChaveIntensidade" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Style="{StaticResource Interruptor}" Click="AoAlternarIntensidade"
                                          AutomationProperties.Name="Cor por intensidade" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- v1.0.0 (Onda 5): consumo do mês, franquia e exportação -->
                <TextBlock Text="Consumo e franquia" Style="{StaticResource Titulo}" />
                <Border Style="{StaticResource Cartao}">
                    <StackPanel>
                        <TextBlock Text="Franquia mensal" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Rotulo}" Margin="0,2,0,6"
                                   Text="Para internet com limite (4G/5G, satélite). Avisa uma vez aos 80 % e uma vez aos 100 % do mês, somando envio e download. Em branco ou 0 = sem franquia." />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="CampoFranquia" Width="100" TextChanged="AoMudarFranquia" AutomationProperties.Name="Franquia mensal em GB" />
                            <TextBlock Text="GB por mês" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="TextoConsumoMes" Style="{StaticResource Rotulo}" Margin="0,6,0,0" AutomationProperties.Name="Consumo do mês" />

                        <Grid Margin="0,16,0,0">
                            <StackPanel Margin="0,0,160,0">
                                <TextBlock Text="Histórico por dia" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Rotulo}"
                                           Text="Guarda o consumo de cada dia por 13 meses. Exporta em CSV para abrir no Excel e comparar com a fatura." />
                            </StackPanel>
                            <Button x:Name="BotaoExportar" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Style="{StaticResource BotaoSecundario}" Content="Exportar CSV…"
                                    Click="AoExportarCsv" AutomationProperties.Name="Exportar consumo em CSV" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 5. Bandeja -->
                <TextBlock Text="Área de notificação" Style="{StaticResource Titulo}" />
                <Border Style="{StaticResource Cartao}">
                    <Grid>
                        <StackPanel Margin="0,0,56,0">
                            <TextBlock Text="Mostrar ícone perto do relógio" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Rotulo}"
                                       Text="Fica sempre visível quando o widget não está fixado na barra — é o caminho para reabrir o app." />
                        </StackPanel>
                        <ToggleButton x:Name="ChaveBandeja" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Style="{StaticResource Interruptor}" Click="AoAlternarBandeja"
                                      AutomationProperties.Name="Mostrar ícone na bandeja" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Rodapé de ações -->
        <Border Grid.Row="1" Background="{DynamicResource Tema.SuperficieRecuada}" BorderBrush="{DynamicResource Tema.Borda}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource BotaoSecundario}" Content="Restaurar padrão"
                            Click="AoRestaurarPadrao" AutomationProperties.Name="Restaurar padrão" />
                    <!-- v0.4.0: versão + estado da atualização automática ("auto update") -->
                    <TextBlock x:Name="TextoVersao" Style="{StaticResource Rotulo}" VerticalAlignment="Center"
                               Margin="14,0,0,0" AutomationProperties.Name="Versão" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="TextoEstadoSalvo" Style="{StaticResource Rotulo}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Style="{StaticResource BotaoSecundario}" Content="Fechar" Margin="0,0,8,0" IsCancel="True"
                            Click="AoFechar" AutomationProperties.Name="Fechar" />
                    <Button x:Name="BotaoAplicar" Style="{StaticResource BotaoPrincipal}" Content="Aplicar" IsDefault="True"
                            Click="AoAplicar" AutomationProperties.Name="Aplicar" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
