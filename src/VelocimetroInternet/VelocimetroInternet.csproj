<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Ícone do .exe (recurso 32512): Explorer, Alt+Tab do estúdio e a bandeja (IconeBandeja) -->
    <ApplicationIcon>Recursos/app.ico</ApplicationIcon>
    <Version>0.6.0</Version>
    <AssemblyVersion>0.6.0.0</AssemblyVersion>
    <FileVersion>0.6.0.0</FileVersion>
    <!-- v0.4.0 (Onda 4): ponto de entrada próprio (Program.cs) — o Velopack precisa rodar ANTES
         do WPF. StartupObject desempata com o Main que o WPF gera para o App.xaml. -->
    <StartupObject>VelocimetroInternet.Program</StartupObject>
    <!-- v0.6.0: nome que o Windows MOSTRA (Gerenciador de Tarefas, aba Inicializar, Propriedades
         do .exe). O nome do arquivo (VelocimetroInternet.exe), o namespace e o packId do Velopack
         continuam: trocar quebraria a atualização automática e a entrada "Iniciar com o Windows". -->
    <Product>Status Monitor</Product>
    <AssemblyTitle>Status Monitor</AssemblyTitle>
    <Description>Status Monitor — CPU, RAM e velocidade de internet na barra de tarefas</Description>
  </PropertyGroup>

  <!-- Blindagem: o hook de backup automático pode criar "backup\" DENTRO desta pasta quando o
       diretório de trabalho do agente está aqui — o SDK incluiria as cópias e a compilação
       quebraria com "definição duplicada" (aconteceu em 2026-10-31).
       v0.3.0: "**\backup\**" cobre QUALQUER subpasta — o hook também criou Apresentacao\backup\
       quando o diretório de trabalho era Apresentacao (o padrão antigo só cobria a raiz). -->
  <ItemGroup>
    <Compile Remove="**\backup\**" />
    <Page Remove="**\backup\**" />
    <None Remove="**\backup\**" />
    <Content Remove="**\backup\**" />
  </ItemGroup>
  <!-- Único pacote externo: Velopack (instalador sem administrador + atualização automática
       silenciosa pelas Releases do GitHub). A ferramenta "vpk" tem de estar na MESMA versão. -->
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
