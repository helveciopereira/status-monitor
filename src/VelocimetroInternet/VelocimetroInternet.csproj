<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Ícone do .exe (recurso 32512): Explorer, Alt+Tab do estúdio e a bandeja (IconeBandeja) -->
    <ApplicationIcon>Recursos/app.ico</ApplicationIcon>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
  </PropertyGroup>

  <!-- Blindagem: o hook de backup automático pode criar "backup\" DENTRO desta pasta quando o
       diretório de trabalho do agente está aqui — o SDK incluiria as cópias e a compilação
       quebraria com "definição duplicada" (aconteceu em 2026-10-31).
       v0.3.0: "**\backup\**" cobre QUALQUER subpasta — o hook também criou Apresentacao\backup\
       quando o diretório de trabalho era Apresentacao (o padrão antigo só cobria a raiz). -->
  <ItemGroup>
    <Compile Remove="**\backup\**" />
    <Page Remove="**\backup\**" />
    <None Remove="**\backup\**" />
    <Content Remove="**\backup\**" />
  </ItemGroup>

</Project>
